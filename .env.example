# Copy this file to .env and fill in your values: cp .env.example .env

# --- v1: POST /message/rephrase (OpenAI) ---
OPEN_AI_SECRET=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- v2: POST /v2/message/rephrase (Amazon Bedrock) ---
# Credentials come from the standard AWS chain (env vars, ~/.aws profile, IAM role)
# or set a Bedrock API key here. Never commit real keys.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Timeout (seconds) for provider calls, applies to both
LLM_TIMEOUT_SECONDS=30
